@inherits RfEventComponent

<section class="card h-100 island island-@RendererInfo.Name.ToLowerInvariant()">
    <div class="card-header d-flex align-items-center gap-2">
        <strong class="me-auto">@Name</strong>
        <span class="badge text-bg-secondary">@RendererInfo.Name</span>
        <span class="badge @(RendererInfo.IsInteractive ? "text-bg-success" : "text-bg-warning")">@(RendererInfo.IsInteractive ? "interactive" : "not interactive yet")</span>
    </div>
    <div class="card-body">
        <p class="mb-2">Shared <code>IslandState.Count</code>: <strong class="fs-4">@Island.Count</strong></p>
        <div class="d-flex flex-wrap gap-2 mb-2">
            <button class="btn btn-sm btn-primary" disabled="@(!RendererInfo.IsInteractive)" @onclick="Increment">Increment</button>
            <button class="btn btn-sm btn-outline-primary" disabled="@(!RendererInfo.IsInteractive)" @onclick="PingAsync">Ping other islands</button>
        </div>
        <p class="small mb-0 text-body-secondary">Last ping received: <strong>@(_lastPing ?? "none")</strong></p>
    </div>
</section>
