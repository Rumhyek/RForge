@inherits BusComponentBase

@if (IsActive)
{
    <form class="d-flex flex-column gap-2" @onsubmit="Continue">
        <input class="form-control" placeholder="Card number (any value)" @bind="_card" />
        <div class="d-flex gap-2 justify-content-end">
            <button class="btn btn-outline-secondary" type="button" @onclick="Back">Back</button>
            <button class="btn btn-primary" type="submit" disabled="@string.IsNullOrWhiteSpace(_card)">Review order</button>
        </div>
    </form>
}
