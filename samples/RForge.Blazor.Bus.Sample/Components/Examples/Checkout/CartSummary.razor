@inherits BusComponentBase

<section class="card">
    <div class="card-header d-flex align-items-center">
        <span class="me-auto">Cart</span>
        <button class="btn btn-sm btn-outline-secondary" disabled="@(Cart.Lines.Count == 0)" @onclick="Empty">Empty</button>
    </div>
    <ul class="list-group list-group-flush">
        @if (Cart.Lines.Count == 0)
        {
            <li class="list-group-item text-body-secondary small">Your cart is empty.</li>
        }
        @foreach (var line in Cart.Lines)
        {
            <li class="list-group-item d-flex small" @key="line.ProductId">
                <span class="me-auto">@line.Emoji @line.Name × @line.Quantity</span>
                <span>@((line.Price * line.Quantity).ToString("C"))</span>
            </li>
        }
    </ul>
    <div class="card-footer d-flex small">
        <strong class="me-auto">Total</strong>
        <strong>@Cart.Total.ToString("C")</strong>
    </div>
    @if (Cart.Source is not null)
    {
        <div class="card-footer small text-body-secondary">@Cart.Source</div>
    }
</section>
