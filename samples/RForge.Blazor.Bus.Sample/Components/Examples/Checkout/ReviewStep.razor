@inherits BusComponentBase

@if (Form.Status == CheckoutStatus.Editing && Form.Step == 3)
{
    <dl class="row small mb-2">
        <dt class="col-4">Name</dt><dd class="col-8">@Form.Name</dd>
        <dt class="col-4">Email</dt><dd class="col-8">@Form.Email</dd>
        <dt class="col-4">Address</dt><dd class="col-8">@Form.Address</dd>
        <dt class="col-4">Card</dt><dd class="col-8">•••• @Last4(Form.Card)</dd>
        <dt class="col-4">Items</dt><dd class="col-8">@Cart.Count (@Cart.Total.ToString("C"))</dd>
    </dl>
    <div class="d-flex gap-2 justify-content-end">
        <button class="btn btn-outline-secondary" @onclick="Back">Back</button>
        <button class="btn btn-success" disabled="@(Cart.Count == 0)" @onclick="PlaceOrderAsync">Place order</button>
    </div>
    @if (Cart.Count == 0)
    {
        <div class="text-danger small text-end mt-1">Add something to the cart first.</div>
    }
}
