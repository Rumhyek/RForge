@inherits RfEventComponent

<section class="card h-100">
    <div class="card-header">Tick tape <small class="text-body-secondary">(events)</small></div>
    <ul class="list-group list-group-flush tick-tape">
        @foreach (var tick in _ticks)
        {
            <li class="list-group-item small d-flex">
                <span class="me-2 text-body-secondary">@tick.At.ToString("HH:mm:ss.f")</span>
                <span class="me-auto fw-semibold">@tick.Symbol</span>
                <span class="@(tick.Change >= 0 ? "text-success" : "text-danger")">@tick.Price.ToString("N2") (@tick.Change.ToString("+0.00;-0.00"))</span>
            </li>
        }
    </ul>
</section>
