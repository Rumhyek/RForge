@inherits RfEventComponent

<div class="toast-stack" aria-live="polite">
    @foreach (var toast in _toasts)
    {
        <div @key="toast.Id" class="toast show align-items-center text-bg-@CssFor(toast.Level) border-0" role="status">
            <div class="d-flex">
                <div class="toast-body">@toast.Message</div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" aria-label="Close" @onclick="() => Dismiss(toast.Id)"></button>
            </div>
        </div>
    }
</div>
