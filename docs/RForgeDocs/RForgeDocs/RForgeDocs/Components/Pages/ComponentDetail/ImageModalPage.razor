@page "/image-modal/details"

<ComponentDetail Title="Modal (Image)"
                 PlaygroundUrl="/image-modal/playground"
                 SubTitle="Minimal modal implementation">

    <Examples>
        @ComponentDetail.SideLink(("Basic example", TagInfo.Empty, "/image-modal/example/basic-example"))

    </Examples>

    <RepoLinks>
        @ComponentDetail.SideLink(("RfModalImage.razor", TagInfo.Razor, "https://github.com/Rumhyek/RForge/blob/main/src/RForge/RForge.Blazor.Components/RfModalImage.razor"))
        @ComponentDetail.SideLink(("RfModalImage.razor.cs", TagInfo.Backend, "https://github.com/Rumhyek/RForge/blob/main/src/RForge/RForge.Blazor.Components/RfModalImage.razor.cs"))
        @ComponentDetail.SideLink(("RfModalBase.cs", TagInfo.Base, "https://github.com/Rumhyek/RForge/blob/main/src/RForge/RForge.Blazor.Components/Models/RfModalBase.cs"))
        @ComponentDetail.SpacerLink()
        @ComponentDetail.SideLink(("AspectRatio.cs", TagInfo.Enum, "https://github.com/Rumhyek/RForge/blob/main/src/RForge/RForge.Blazor.Abstractions/AspectRatio.cs"))
    </RepoLinks>

    <Purpose>
        <div class="content">

            <p>
                <code>RfModalImage</code> creates a modal designed to show an image.
            </p>

            <h4>When to Use</h4>
            <p>
                Use <code>RfModalImage</code> when you need to display a large view of an image.
            </p>

            <h4>When not to Use</h4>
            <p>Don't use <code>RfModalImage</code> when:</p>
            <ul>
                <li>
                    Dealing with editing / uploading of an image. Instead use <code>RfCardModal</code>.
                </li>
            </ul>
        </div>
    </Purpose>

    <Setup>
        <BasicSetupDetails />
    </Setup>


    <BasicUsage>

        <div class="content">

            <p>
                <code>RfModalImage</code> works by making use of <code>IsVisible</code> and <code>ImageUrl</code> parameters.
                It supports two way binding allowing the modal itself to close it. 
                You may also supply it with an caption and aspect ratio via <code>ImageCaption</code> and <code>AspectRatio</code>.
            </p>

            <p>Below show a basic example of <code>RfModalImage</code>.</p>

            <pre><xmp><RfModalImage @@bind-IsVisible="ModalIsVisible" ImageUrl="https//placehold.co/600/" />
<a class="button" @@onclick="OnShowModalClick">Show Modal</a>

@@code {
    public bool ModalIsVisible { get; set; }

    public void OnShowModalClick() => ModalIsVisible = true;
}</xmp></pre>

            <h4>Closing with Esc</h4>
            <p>
                While it is visible, Esc closes the modal if <code>ShowCloseButton</code> is true. With no close button Esc does nothing, and it
                can't reach a modal behind this one. This uses <a href="/hot-key/details"><code>RfHotKey</code></a>, which loads a small
                JavaScript file. Set <code>UseHotKeys="false"</code> to load no JavaScript, and the modal then ignores Esc.
            </p>

        </div>

    </BasicUsage>


</ComponentDetail>

