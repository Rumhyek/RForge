@page "/basic-modal/details"

<ComponentDetail Title="Modal (Basic)"
                 PlaygroundUrl="/basic-modal/playground"
                 SubTitle="Minimal modal implementation">

    <Examples>
        @ComponentDetail.SideLink(("Basic example", TagInfo.Empty, "/basic-modal/example/basic-example"))

    </Examples>

    <RepoLinks>
        @ComponentDetail.SideLink(("RfModal.razor", TagInfo.Razor, "https://github.com/Rumhyek/RForge/blob/main/src/RForge/RForge.Blazor.Components/RfModal.razor"))
        @ComponentDetail.SideLink(("RfModal.razor.cs", TagInfo.Backend, "https://github.com/Rumhyek/RForge/blob/main/src/RForge/RForge.Blazor.Components/RfModal.razor.cs"))
        @ComponentDetail.SideLink(("RfModalBase.cs", TagInfo.Base, "https://github.com/Rumhyek/RForge/blob/main/src/RForge/RForge.Blazor.Components/Models/RfModalBase.cs"))
    </RepoLinks>

    <Purpose>
        <div class="content">

            <p>
                <code>RfModal</code> creates a basic modal that supports the minimum required setup.
            </p>

            <h4>When to Use</h4>
            <p>
                Use <code>RfModal</code> when you need to create a custom modal but don't need to recreate
                the visibility code again.
            </p>

            <h4>When not to Use</h4>
            <p>Don't use <code>RfModal</code> when:</p>
            <ul>
                <li>
                    Dealing with forms. Instead use <a href="/card-modal/details"><code>RfCardModal</code></a>.
                </li>
                <li>
                    Dealing with images. Instead use <a href="/image-modal/details"><code>RfImageModal</code></a>.
                </li>
                <li>
                    Creating confirmation, alerts, or prompt dialogs.
                    Instead use <a href="/dialog-manager/details"><code>RfDialogManager</code></a>.
                </li>
            </ul>
        </div>
    </Purpose>

    <Setup>
        <BasicSetupDetails />
    </Setup>


    <BasicUsage>

        <div class="content">

            <p>
                <code>RfModal</code> works by making use of <code>IsVisible</code> parameter.
                It supports two way binding allowing the modal itself to close it. 
                The <code>ChildContent</code> is then used to render the contents of the modal.

            </p>

            <p>Below show a basic example of <code>RfModal</code>.</p>

            <pre><xmp><RfModal @@bind-IsVisible="ModalIsVisible" />
<a class="button" @@onclick="OnShowModalClick">Show Modal</a>

@@code {
    public bool ModalIsVisible { get; set; }

    public void OnShowModalClick() => ModalIsVisible = true;
}</xmp></pre>

            <h4>Closing with Esc</h4>
            <p>
                While it is visible, Esc closes the modal if <code>ShowCloseButton</code> is true. With no close button Esc does nothing, and it
                can't reach a modal behind this one. This uses <a href="/hot-key/details"><code>RfHotKey</code></a>, which loads a small
                JavaScript file. Set <code>UseHotKeys="false"</code> to load no JavaScript, and the modal then ignores Esc.
            </p>

        </div>

    </BasicUsage>


</ComponentDetail>

