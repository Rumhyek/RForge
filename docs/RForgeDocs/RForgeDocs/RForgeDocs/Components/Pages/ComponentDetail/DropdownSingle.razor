@page "/dropdown-single/details"

<ComponentDetail Title="Dropdown (Single)"
                 PlaygroundUrl="/dropdown-single/playground"
                 SubTitle="A searchable drop down with one selection">

    <Examples>
        @ComponentDetail.SideLink(("String example", TagInfo.Empty, "/dropdown-single/example/string-example"))
        @ComponentDetail.SideLink(("Object example", TagInfo.Empty, "/dropdown-single/example/object-example"))
        @ComponentDetail.SideLink(("Dynamic example", TagInfo.Empty, "/dropdown-single/example/complete-example"))
        @ComponentDetail.SideLink(("Custom rendering example", TagInfo.Empty, "/dropdown-single/example/selection-customization-example"))
        @ComponentDetail.SideLink(("Dependant (nested)", TagInfo.Empty, "/dropdown-single/example/dependant-example-nested"))
        @ComponentDetail.SideLink(("Dependant (separated)", TagInfo.Empty, "/dropdown-single/example/dependant-example-separated"))

    </Examples>

    <RepoLinks>
        @ComponentDetail.SideLink(("RfDropDown.razor", TagInfo.Razor, "https://github.com/Rumhyek/RForge/blob/main/src/RForge/RForgeBlazor/RfDropDown.razor"))
        @ComponentDetail.SideLink(("RfDropDown.razor.cs", TagInfo.Backend, "https://github.com/Rumhyek/RForge/blob/main/src/RForge/RForgeBlazor/RfDropDown.razor.cs"))
        @ComponentDetail.SideLink(("RfDropDownBase.cs", TagInfo.Base, "https://github.com/Rumhyek/RForge/blob/main/src/RForge/RForgeBlazor/Models/RfDropDownBase.cs"))
        @ComponentDetail.SpacerLink()
        @ComponentDetail.SideLink(("RfDropDownPosition.cs", TagInfo.Enum, "https://github.com/Rumhyek/RForge/blob/main/src/RForge/RForge.Abstractions/DropDowns/RfDropDownPosition.cs"))
        @ComponentDetail.SideLink(("RfShowSelectionInDropDown.cs", TagInfo.Enum, "https://github.com/Rumhyek/RForge/blob/main/src/RForge/RForge.Abstractions/DropDowns/RfShowSelectionInDropDown.cs"))
    </RepoLinks>
    
    <Purpose>
        <div class="content">

            <p>
                <code>RfDropDown</code> creates a Bulma dropdown that supports searching and manages the selection of an item.
            </p>
            
            <h4>When not to Use</h4>
            <p>Don't use <code>RfDropDown</code> when:</p>
            <ul>
                <li>
                    When using static rendering mode. Instead use <code>InputSelect</code>.
                </li>
            </ul>
        </div>
    </Purpose>

    <BasicUsage>
        <div class="content">
            <p>
                The <code>RfDropDown</code> works primarily with two parameters: <code>SelectedItem</code> and <code>Items</code>.
            </p>

            <h3>How are Items Render?</h3>
            <p>
                The dropdown doesn't make any assumptions on how to render the items or selected item it is given. 
                Instead the drop down supports three <code>RenderFragement</code> to customize the way an item appears within the drop down.
                All three <code>RenderFragement</code> have a context of <code>TItem</code> and are used to setup two sections.
                The two sections of the drop down that can be custimized are <code>RowItemTemplate</code> and <code>SelectedItemTemplate</code>.
            </p>

            <h5>Row Item Template</h5>
            <p>
                The <code>RowItemTempalte</code> directly sets each row or option of the drop down. Each row is wrapped in the following code:
                <pre><code><xmp><a class="dropdown-item">@@RowItemTemplate(item)</a></xmp></code></pre>

                If <code>RowItemTemplate</code> isn't set the drop down will use <code>ChildContent</code>.
            </p>

            <h5>Selected Item Template</h5>
            <p>
                When the drop down has a selection it calls the <code>SelectedItemTemplate</code> to render the <code>TItem</code> within the input portion of the drop down. 
                The selected item is wrapped in the following code:
                <pre><code><xmp><span>@@SelectedItemTemplate(SelectedItem)</span></xmp></code></pre>

                If <code>SelectedItemTemplate</code> isn't set the drop down will use <code>ChildContent</code>.
            </p>

            <h3>Loading Items</h3>
            <p>
                When the items come from a service instead of a static list, set <code>OnLoad</code>. The drop down calls it with the
                current filter text and expects your handler to assign <code>Items</code>. Clicking the trigger runs the open
                sequence: the loading state is applied (Bulma shows the spinner on the trigger icon), <code>OnLoad</code> is
                awaited, the loading state is cleared, and the panel opens only after your handler has returned.
            </p>
            <p>
                An attempt to open while a load is in flight is ignored: no second <code>OnLoad</code> starts and the component
                keeps the state of the load that is running. Typing in the filter re-invokes <code>OnLoad</code> with the new
                filter text while the panel stays open; set <code>FilterRateLimit</code> to hold keystrokes until the rate elapses
                and fire only the latest filter.
            </p>
            <h4>Loader exceptions</h4>
            <p>
                The loading state is released in a <code>finally</code>, so a handler that throws cannot latch the drop down into a
                permanent loading state. The failed attempt leaves the drop down closed, the exception still propagates to your
                app's event handling (Blazor's unhandled exception path unless you catch it), and the next click calls
                <code>OnLoad</code> again. Before this fix a throwing handler left the loading state set forever and the drop down
                could never be opened again.
            </p>
            <div class="notification">
                <strong>NOTE:</strong> If a load can fail and you still want the panel to open, catch the exception inside your
                <code>OnLoad</code> handler: when the handler returns normally the panel opens with whatever you left in
                <code>Items</code>; when it throws, the attempt ends closed.
            </div>
            <h5>Example: loading items on open</h5>
            <pre><code>&lt;RfDropDown TItem="string"
                   Items="@@Items"
                   @@bind-SelectedItem="@@Selected"
                   OnLoad="@@LoadNames" /&gt;</code></pre>
            <pre><code>private async Task LoadNames(string filter)
{
    Items = await NameService.SearchAsync(filter);
}</code></pre>

            <h3>Styling</h3>
            <p>
                The drop down passes four class parameters through to the elements it renders, so you can style it without fighting the component:
            </p>
            <ul>
                <li>
                    <code>CssClass</code> is added to the root <code>div.dropdown</code> element, alongside the state classes the
                    component manages itself (<code>is-active</code> while open, <code>is-right</code> and <code>is-up</code> from <code>Position</code>).
                </li>
                <li>
                    <code>CssFilterClass</code> is added to the filter textbox alongside the Bulma <code>input</code> class.
                    It has no effect while <code>ShowFilter</code> hides the filter.
                </li>
                <li>
                    <code>CssRowItemClass</code> is added to every option row inside the drop down panel.
                </li>
                <li>
                    <code>CssSelectedClass</code> is added to the span wrapping the selected item in the trigger.
                </li>
            </ul>
            <p>
                Unset parameters add nothing: the rendered markup is identical to a drop down that never had them.
            </p>

            <h5>Example:</h5>
            <pre><code>&lt;RfDropDown TItem="string"
                Items="@@Items"
                @@bind-SelectedItem="@@Selected"
                CssClass="wide-dropdown"
                CssFilterClass="is-rounded" /&gt;</code></pre>
            <p>
                With the panel open this renders the root as <code>class="dropdown is-active wide-dropdown"</code>
                and the filter textbox as <code>class="input is-rounded"</code>.
            </p>

        </div>
    </BasicUsage>

    <Setup>
        <BasicSetupDetails />
    </Setup>
</ComponentDetail>

