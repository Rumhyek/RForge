@page "/events/example/shared-counter"

@rendermode InteractiveAuto

<ExampleDetail Title="Shared State"
               SubTitle="Events"
               ComponentName="Events"
               PageSourceUrl="@RForgeHelpers.RepoDocsUrl("/RForgeDocs.Client/Pages/Examples/Events/SharedCounterPage.razor")"
               ComponentDetailsUrl="/events/details" />

<div class="columns">
    <div class="column is-5">
        <article class="section">
            <div class="box">
                <div class="content">
                    <ExampleHeader Level="Simple" Mode="Interactive Auto">
                        Three components with no shared parent and no parameters between them read and write one piece of state.
                    </ExampleHeader>

                    <HowItWorks>
                        <p><strong>Try it:</strong> click <em>+1</em> and <em>+2</em> and watch the render counters.</p>
                        <ul>
                            <li><code>ClickState</code> is a record implementing <code>IState&lt;ClickState&gt;</code>. The root hub creates it on first use from <code>ClickState.Initial</code>.</li>
                            <li><code>ClickButtons</code> writes with <code>State&lt;ClickState&gt;().Update(...)</code>. It never reads the state reactively, so it only re-renders after its own clicks (normal Blazor behavior for event handlers).</li>
                            <li><code>ClickDisplay</code> declares <code>[UseState] private partial ClickState Clicks { get; }</code> and re-renders on every change.</li>
                            <li><code>ParityBadge</code> uses a selector, <code>SelectIsEven</code>. <em>+2</em> doesn't change parity, so it doesn't re-render.</li>
                            <li><em>Set same value</em> writes an equal record. Record equality turns that into a no-op, so nothing re-renders.</li>
                        </ul>
                    </HowItWorks>
                </div>
            </div>
        </article>
    </div>
    <div class="column">
        <article class="section">
            <div class="columns is-multiline">
                <div class="column is-12-tablet is-4-desktop">
                    <section class="card">
                        <header class="card-header"><p class="card-header-title">Writer&nbsp;<code>ClickButtons</code></p></header>
                        <div class="card-content"><ClickButtons /></div>
                    </section>
                </div>
                <div class="column is-12-tablet is-4-desktop">
                    <section class="card">
                        <header class="card-header"><p class="card-header-title">Whole value&nbsp;<code>[UseState]</code></p></header>
                        <div class="card-content"><ClickDisplay /></div>
                    </section>
                </div>
                <div class="column is-12-tablet is-4-desktop">
                    <section class="card">
                        <header class="card-header"><p class="card-header-title">Selector&nbsp;<code>[UseState(Select = …)]</code></p></header>
                        <div class="card-content"><ParityBadge /></div>
                    </section>
                </div>
            </div>
        </article>
    </div>
</div>
